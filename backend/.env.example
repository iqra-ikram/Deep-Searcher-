# AI Research Assistant - Backend Environment Variables
# Copy this file to .env in the backend/ folder and fill in real values.
# Never commit your actual .env file.

# Required for chat generation and non-English YouTube translation.
GROQ_API_KEY=replace_with_your_groq_api_key

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Groq chat model.
LLM_MODEL=openai/gpt-oss-20b

# Optional limits and runtime settings.
MAX_PDF_SIZE_MB=20
RETRIEVER_K=4
SESSION_TTL_SECONDS=21600
MAX_SESSIONS=200
MAX_HISTORY_CHARS=20000
MAX_WEBSITE_CHARS=200000
DEBUG=false
